<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- The desktop project targets Windows; this lets Linux and macOS build and test it too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Version>0.4.8</Version>
    <FileVersion>0.4.8.0</FileVersion>
    <AssemblyVersion>0.4.8.0</AssemblyVersion>
    <Product>Sluice</Product>
    <Authors>Sluice contributors</Authors>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
